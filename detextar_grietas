import os
import torch
import torch.nn as nn
import matplotlib.pyplot as plt
from torch.utils.data import DataLoader, random_split, Dataset
from torchvision import transforms
from PIL import Image

# ==========================================
# 1. PRE-PROCESAMIENTO Y CONFIGURACIÓN
# ==========================================

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Dispositivo de cómputo seleccionado: {device}", flush=True)

transform_train = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.RandomHorizontalFlip(),
    transforms.RandomRotation(15),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
])

transform_eval = transforms.Compose([
    transforms.Resize((224, 224)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
])

# ==========================================
# 2. CARGA Y DIVISIÓN DE DATOS (70% / 15% / 15%)
# ==========================================

class DatasetGrietas(Dataset):
    def __init__(self, root_dir, transform=None):
        self.transform = transform
        self.samples = []
        self.class_to_idx = {'Negative': 0, 'Positive': 1}
        
        for clase, etiqueta in self.class_to_idx.items():
            carpeta_clase = os.path.join(root_dir, clase)
            if os.path.exists(carpeta_clase):
                for archivo in os.listdir(carpeta_clase):
                    if archivo.lower().endswith(('png', 'jpg', 'jpeg', 'bmp')):
                        self.samples.append((os.path.join(carpeta_clase, archivo), etiqueta))

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, index):
        ruta_img, etiqueta = self.samples[index]
        imagen = Image.open(ruta_img).convert('RGB')
        if self.transform is not None:
            imagen = self.transform(imagen)
        return imagen, etiqueta

ruta_proyecto = os.path.dirname(os.path.abspath(__file__))
dataset_completo = DatasetGrietas(root_dir=ruta_proyecto, transform=transform_train)

total_imagenes = len(dataset_completo)
print(f"Total de imágenes detectadas: {total_imagenes}", flush=True)

if total_imagenes == 0:
    raise ValueError("No se encontraron imágenes en las carpetas Positive o Negative.")

train_size = int(0.70 * total_imagenes)
val_size = int(0.15 * total_imagenes)
test_size = total_imagenes - train_size - val_size

train_dataset, val_dataset, test_dataset = random_split(
    dataset_completo, [train_size, val_size, test_size],
    generator=torch.Generator().manual_seed(42)
)

val_dataset.dataset.transform = transform_eval
test_dataset.dataset.transform = transform_eval

print(f"Entrenamiento: {train_size} | Validación (Aprobación): {val_size} | Prueba (Test): {test_size}", flush=True)

batch_size = 64
train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True)
val_loader = DataLoader(val_dataset, batch_size=batch_size, shuffle=False)
test_loader = DataLoader(test_dataset, batch_size=batch_size, shuffle=False)

# ==========================================
# 3. MODELO CNN + FEED-FORWARD (SIN SIGMOID FINAL)
# ==========================================

class DetectorGrietas(nn.Module):
    def __init__(self):
        super(DetectorGrietas, self).__init__()
        
        self.features = nn.Sequential(
            nn.Conv2d(3, 32, kernel_size=3, padding=1),
            nn.BatchNorm2d(32),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            
            nn.Conv2d(32, 64, kernel_size=3, padding=1),
            nn.BatchNorm2d(64),
            nn.ReLU(),
            nn.MaxPool2d(2, 2),
            
            nn.Conv2d(64, 128, kernel_size=3, padding=1),
            nn.BatchNorm2d(128),
            nn.ReLU(),
            nn.MaxPool2d(2, 2)
        )
        
        self.feed_forward = nn.Sequential(
            nn.Flatten(),
            nn.Linear(128 * 28 * 28, 256),
            nn.ReLU(),
            nn.Dropout(0.5),
            nn.Linear(256, 1)  # Retiramos Sigmoid para estabilidad con BCEWithLogitsLoss
        )

    def forward(self, x):
        x = self.features(x)
        x = self.feed_forward(x)
        return x

modelo = DetectorGrietas().to(device)

# ==========================================
# 4. ENTRENAMIENTO (ESTABILIZADO)
# ==========================================

criterio = nn.BCEWithLogitsLoss()
optimizador = torch.optim.Adam(modelo.parameters(), lr=0.0001)

epocas = 10
historial_train_loss, historial_val_loss = [], []
historial_train_acc, historial_val_acc = [], []

print("\n--- Iniciando Entrenamiento ---", flush=True)
total_lotes = len(train_loader)

for epoca in range(epocas):
    # Fase de Entrenamiento
    modelo.train()
    loss_acumulada_train, aciertos_train = 0.0, 0
    
    for i, (imagenes, etiquetas) in enumerate(train_loader):
        imagenes = imagenes.to(device)
        etiquetas = etiquetas.to(device).float().unsqueeze(1)
        
        optimizador.zero_grad()
        salida = modelo(imagenes)
        loss = criterio(salida, etiquetas)
        loss.backward()
        optimizador.step()
        
        loss_acumulada_train += loss.item()
        predicciones = (torch.sigmoid(salida) >= 0.5).float()
        aciertos_train += (predicciones == etiquetas).sum().item()

        if (i + 1) % 50 == 0 or (i + 1) == total_lotes:
            print(f"Época {epoca+1:02d}/{epocas} -> Lote {i+1}/{total_lotes} procesado", flush=True)
        
    train_loss = loss_acumulada_train / len(train_loader)
    train_acc = aciertos_train / train_size

    # Fase de Validación
    modelo.eval()
    loss_acumulada_val, aciertos_val = 0.0, 0
    with torch.no_grad():
        for imagenes, etiquetas in val_loader:
            imagenes = imagenes.to(device)
            etiquetas = etiquetas.to(device).float().unsqueeze(1)
            
            salida = modelo(imagenes)
            loss = criterio(salida, etiquetas)
            
            loss_acumulada_val += loss.item()
            predicciones = (torch.sigmoid(salida) >= 0.5).float()
            aciertos_val += (predicciones == etiquetas).sum().item()
            
    val_loss = loss_acumulada_val / len(val_loader)
    val_acc = aciertos_val / val_size

    historial_train_loss.append(train_loss)
    historial_val_loss.append(val_loss)
    historial_train_acc.append(train_acc)
    historial_val_acc.append(val_acc)

    print(f"\n>>> RESULTADO ÉPOCA {epoca+1:02d}/{epocas} <<<", flush=True)
    print(f"Train Loss: {train_loss:.4f} | Train Acc: {train_acc*100:.2f}%", flush=True)
    print(f"Val Loss:   {val_loss:.4f} | Val Acc:   {val_acc*100:.2f}%\n", flush=True)

    # Respaldo automático por época
    torch.save(modelo.state_dict(), os.path.join(ruta_proyecto, 'modelo_grietas.pth'))
    print(f"-> Respaldo guardado automáticamente (Época {epoca+1:02d})\n", flush=True)

print("Entrenamiento completado y modelo guardado exitosamente como 'modelo_grietas.pth'", flush=True)

# ==========================================
# 5. EVALUACIÓN FINAL EN TEST (15%)
# ==========================================

print("\n--- Evaluación Final en Test (15%) ---", flush=True)
modelo.eval()
aciertos_test = 0
with torch.no_grad():
    for imagenes, etiquetas in test_loader:
        imagenes = imagenes.to(device)
        etiquetas = etiquetas.to(device).float().unsqueeze(1)
        salida = modelo(imagenes)
        predicciones = (torch.sigmoid(salida) >= 0.5).float()
        aciertos_test += (predicciones == etiquetas).sum().item()

test_acc = aciertos_test / test_size
print(f"Precisión Final en Datos de Prueba (Test Accuracy): {test_acc*100:.2f}%", flush=True)

# ==========================================
# 6. MOSTRAR GRÁFICAS
# ==========================================

plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.plot(range(1, epocas + 1), historial_train_loss, label='Pérdida Entrenamiento (70%)')
plt.plot(range(1, epocas + 1), historial_val_loss, label='Pérdida Validación (15%)')
plt.title('Pérdida por Época')
plt.xlabel('Época')
plt.ylabel('Pérdida (Loss)')
plt.legend()
plt.grid(True)

plt.subplot(1, 2, 2)
plt.plot(range(1, epocas + 1), historial_train_acc, label='Precisión Entrenamiento (70%)')
plt.plot(range(1, epocas + 1), historial_val_acc, label='Precisión Validación (15%)')
plt.title('Precisión por Época')
plt.xlabel('Época')
plt.ylabel('Precisión (Accuracy)')
plt.legend()
plt.grid(True)

plt.tight_layout()
plt.show()